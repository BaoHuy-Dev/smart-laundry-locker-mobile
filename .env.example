# API Configuration
# Mặc định trỏ về backend đã deploy trên DigitalOcean (cả nhóm dùng chung server + DB,
# không cần bật docker local). Copy file này sang .env và giữ nguyên URL server.
# Chỉ đổi khi cần chạy backend local: emulator Android dùng http://10.0.2.2:18080.
API_URL=http://146.190.84.136:8080/api
API_BASE_URL=http://146.190.84.136:8080

# Firebase Configuration
# Get these values from Firebase Console -> Project Settings
FIREBASE_API_KEY=your_firebase_api_key
FIREBASE_AUTH_DOMAIN=your_project.firebaseapp.com
FIREBASE_PROJECT_ID=your_project_id
FIREBASE_STORAGE_BUCKET=your_project.firebasestorage.app
FIREBASE_MESSAGING_SENDER_ID=your_sender_id
FIREBASE_APP_ID=your_app_id
FIREBASE_MEASUREMENT_ID=G-XXXXXXXXXX
